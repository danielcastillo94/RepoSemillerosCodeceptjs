{
  "name": "actividad-youtube",
  "version": "1.0.0",
  "main": "codecept.conf.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:workers": "codeceptjs run-workers 2",
    "features": "codeceptjs run --features --plugins allure",
    "features:busqueda": "codeceptjs run --features --grep \"@busquedaLiverpool\" --steps --verbose",
    "features:navegar": "codeceptjs run --features --grep \"@navegacioncategoria\" --steps --verbose",
    "features:filtro": "codeceptjs run --features --grep \"@filtroprecio\" --steps --verbose",
    "features:marcas": "codeceptjs run --features --grep \"@filtromarcas\" --steps --verbose",
    "features:tallas": "codeceptjs run --features --grep \"@filtrotallas\" --steps --verbose",
    "features:detallesbasicos": "codeceptjs run --features --grep \"@detallesbasicos\" --steps --verbose",
    "features:stockdisponible": "codeceptjs run --features --grep \"@stockdisponible\" --steps --verbose",
    "allure:generate": "allure generate output --clean",
    "allure:report": "allure open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@codeceptjs/allure-legacy": "^1.0.2",
    "allure-codeceptjs": "^3.2.2",
    "allure-commandline": "^2.34.1",
    "chai": "^4.5.0",
    "codeceptjs": "^3.7.3",
    "playwright": "^1.52.0"
  },
  "dependencies": {
    "@playwright/test": "^1.56.0",
    "dotenv": "^17.2.3"
  }
}
