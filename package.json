{
  "name": "nuevo-framework",
  "version": "1.0.0",
  "description": "Framework de automatización CodeceptJS + Playwright + Gherkin + Allure — Reto S6 Liverpool",
  "scripts": {
    "clean": "rm -rf output allure-report",
    "pretest": "npm run clean",
    "test": "FORCE_COLOR=0 codeceptjs run --steps --grep \"@pendiente\" --invert",
    "test:carrito": "FORCE_COLOR=0 codeceptjs run --steps --grep \"@carrito\"",
    "test:todo": "codeceptjs run --steps",
    "test:pendiente": "codeceptjs run --steps --grep \"@pendiente\"",
    "test:dry": "codeceptjs dry-run",
    "test:smoke": "codeceptjs run --steps --grep \"@smoke\"",
    "test:busqueda": "codeceptjs run --steps --grep \"@busqueda\"",
    "test:filtros": "codeceptjs run --steps --grep \"@filtros\"",
    "test:detalle": "codeceptjs run --steps --grep \"@detalle\"",
    "report:generate": "allure generate output/allure-results -o allure-report --clean",
    "report:serve": "cd allure-report && python3 -m http.server 8080",
    "report": "npm run report:generate && npm run report:serve"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@codeceptjs/allure-legacy": "^1.0.2",
    "allure-commandline": "^2.43.0",
    "codeceptjs": "^4.1.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  }
}
